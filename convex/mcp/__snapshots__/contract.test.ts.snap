  {
    "_meta": {
      "openai/fileParams": [
        "file",
      ],
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
      "title": "Attach an image to a portfolio entry",
    },
    "description": "Attach an image you have generated or the user has provided to one of their portfolio entries, and optionally make it that entry's thumbnail. Use this whenever the user wants a picture on a project — it takes the image directly, so there is no upload step to arrange. Pass usage='thumbnail' to put it on the card, 'gallery' to add it to the entry's images, or 'attachment' for a supporting file. It ADDS to whatever media the entry already has and never removes any, so it is safe to call more than once; use portfolio_set_media instead when the user wants to reorder or remove existing media. The image MUST be image/webp and at most 10MB — this app stores every image as WebP, so convert before attaching; a PNG or JPEG is refused.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "caption": {
          "description": "Optional caption. Max 200 characters.",
          "type": "string",
        },
        "file": {
          "additionalProperties": false,
          "description": "A file the HOST is holding for the user (an upload in the conversation, or an image you generated). The host fills this in; do not construct it yourself and do not pass an id from files_list here.",
          "properties": {
            "download_url": {
              "description": "Temporary URL the server fetches the bytes from.",
              "type": "string",
            },
            "file_id": {
              "description": "Host-side identifier for the file.",
              "type": "string",
            },
            "file_name": {
              "description": "Declared file name. Advisory only.",
              "type": "string",
            },
            "mime_type": {
              "description": "Declared content type. Advisory only.",
              "type": "string",
            },
          },
          "required": [
            "download_url",
            "file_id",
          ],
          "type": "object",
        },
        "item_id": {
          "description": "Id from portfolio_list.",
          "type": "string",
        },
        "usage": {
          "description": "Where the image goes. Defaults to gallery.",
          "enum": [
            "thumbnail",
            "gallery",
            "attachment",
          ],
          "type": "string",
        },
      },
      "required": [
        "item_id",
        "file",
      ],
      "type": "object",
    },
    "name": "portfolio_attach_media",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.write",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Get branding page",
    },
    "description": "Read the state of the user's public personal-brand page (careerpack.org/<slug>): whether it is published, its URL, headline, whether search engines may index it, which built-in template it falls back to, and whether the user has custom HTML (with its size). Call this FIRST before writing or replacing page HTML — it tells you whether you would be overwriting work. Set include_html: true to also get the current HTML back, which can be a few hundred KB, so only do that when you intend to edit it rather than rewrite it. Returns null if the user has not completed onboarding. Publishing is not possible from here: if the page is unpublished, tell the user to flip the switch on the Personal Branding page in the app.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "include_html": {
          "description": "Include the full current HTML. Default false.",
          "type": "boolean",
        },
      },
      "type": "object",
    },
    "name": "branding_get",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.read",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Get branding data",
    },
    "description": "Get the live data the public page renders from — identity, bio, skills, experience, education, certifications, languages, projects — TOGETHER with the marker contract that binds it to HTML. Call this before writing any page HTML with branding_set_html. The page is not a snapshot: markup written with data-cp markers keeps filling from the user's CV and portfolio as those change, so read the returned \`contract\` and use markers instead of pasting the values in as text. It also shows which sections are empty or switched off, so you do not design around data that will never appear.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "name": "branding_data",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.read",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "List branding templates",
    },
    "description": "List the built-in page templates, or fetch one's full HTML to use as a starting point. Call with no argument to see what exists; call with template_id to get the markup. Use 'starter' unless the user asks for one of the others by name — it is ~19 KB and demonstrates every marker, while template-v1/v2/v3 are 67-81 KB design-heavy pages that will fill a large part of your context. This is also the fastest way to see a working example of the marker contract before calling branding_set_html.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "template_id": {
          "description": "One of: starter, template-v1, template-v2, template-v3. Omit to list.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "branding_templates",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.read",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Set branding page HTML",
    },
    "description": "Replace the HTML of the user's public page with a complete document you wrote. This REPLACES the whole page — there is no partial edit, so read branding_get with include_html when you mean to change one part. Call branding_data first and write data-cp markers, not literal values, or the page freezes at today's CV. Max 250,000 characters, inline the CSS, one document from <!doctype html> to </html>. It cannot publish a page: an unpublished one stays private until the user turns it on in the app. But if the page is ALREADY published this replaces what visitors see within about a minute, and there is no version history — so on a live page (the result tells you, and branding_get says so up front) confirm with the user before overwriting.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "html": {
          "description": "The complete HTML document. Max 250,000 characters.",
          "type": "string",
        },
      },
      "required": [
        "html",
      ],
      "type": "object",
    },
    "name": "branding_set_html",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.write",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Delete branding page HTML",
    },
    "description": "Delete the user's custom page HTML so the public page falls back to the built-in template they picked. Use when they want to start over or say the custom page is broken. There is no undo and no version history — the HTML is gone. Ask before calling it if you are the one who wrote that HTML in this conversation.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "name": "branding_delete_html",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.write",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "List interview sessions",
    },
    "description": "List the user's mock interview sessions, newest first: role, type, difficulty, how many questions were answered, the overall score, and when the session started and finished. USE THIS FIRST for any question about interview practice ('how am I doing', 'what did I score last time') and to get an interview_id for the other mock_interview_* tools. Returns a summary only — call mock_interview_get for the questions and answers of one session.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "How many sessions to return. Default 20, max 100.",
          "type": "number",
        },
      },
      "type": "object",
    },
    "name": "mock_interview_list",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.read",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Get interview session",
    },
    "description": "Read one practice session in full: every question with the answer the user gave, the feedback it got and its score, plus the closing feedback. Use it before commenting on how someone answered, so the critique is about what they actually said. Each question carries a \`number\` — that is what mock_interview_answer takes. Returns null if no session with that id belongs to the user.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "interview_id": {
          "description": "Id from mock_interview_list.",
          "type": "string",
        },
      },
      "required": [
        "interview_id",
      ],
      "type": "object",
    },
    "name": "mock_interview_get",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.read",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Start interview session",
    },
    "description": "Open a practice session with the questions YOU wrote, then ask them one at a time in the conversation. Call this before asking the first question, not after the interview — the session is saved as you go, so a chat that ends early still leaves the user their answers. Write the questions in the language the user is speaking (usually Indonesian) and tailor them to the role. Returns interview_id and question_count; questions are then addressed by position, 1..question_count. Do not use this to record a session that already happened elsewhere.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "difficulty": {
          "description": "Question difficulty.",
          "enum": [
            "easy",
            "medium",
            "hard",
          ],
          "type": "string",
        },
        "questions": {
          "description": "1-50 questions, asked in this order.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "category": {
                "description": "Short label for what this one probes, e.g. 'System Design'. Max 50 characters.",
                "type": "string",
              },
              "question": {
                "description": "The question text. Max 1000 characters.",
                "type": "string",
              },
            },
            "required": [
              "question",
              "category",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "role": {
          "description": "The position being practised for, e.g. 'Backend Engineer'. Max 100 characters.",
          "type": "string",
        },
        "type": {
          "description": "Which kind of questions this session is made of.",
          "enum": [
            "behavioral",
            "technical",
            "situational",
            "company-specific",
            "general",
          ],
          "type": "string",
        },
      },
      "required": [
        "role",
        "type",
        "difficulty",
        "questions",
      ],
      "type": "object",
    },
    "name": "mock_interview_start",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.write",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Record interview answer",
    },
    "description": "Save the user's answer to one question of an open session, together with your critique of it. Call this right after they answer, before you ask the next question — that way the feedback is on record even if the conversation stops. question_number is the 1-based position from mock_interview_start or mock_interview_get. score is 0-100 for THIS answer (the app shows it per question); omit it if you are not scoring. Calling it again for the same number overwrites that answer.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "description": "What the user said, in their own words. Max 5000 characters.",
          "type": "string",
        },
        "feedback": {
          "description": "Your critique of this answer — what worked, what to fix. Same language as the answer. Max 5000 characters.",
          "type": "string",
        },
        "interview_id": {
          "description": "Id from mock_interview_start or mock_interview_list.",
          "type": "string",
        },
        "question_number": {
          "description": "1-based position of the question being answered.",
          "type": "number",
        },
        "score": {
          "description": "0-100 for this answer. Omit if not scoring.",
          "type": "number",
        },
      },
      "required": [
        "interview_id",
        "question_number",
        "answer",
      ],
      "type": "object",
    },
    "name": "mock_interview_answer",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.write",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Finish interview session",
    },
    "description": "Close a session with an overall 0-100 score and a summary of how the user did. interview_id is the one mock_interview_start returned. Call it once, after the last answer is saved — this is what makes the session count as completed in the dashboard's average-score and practice-time stats. The elapsed time is measured from when the session was opened, so do not try to supply it. Write the summary in the language the interview was held in.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "feedback": {
          "description": "Closing summary: strengths, weak spots, what to practise next. Max 5000 characters.",
          "type": "string",
        },
        "interview_id": {
          "description": "Id from mock_interview_start or mock_interview_list.",
          "type": "string",
        },
        "overall_score": {
          "description": "0-100 for the session as a whole.",
          "type": "number",
        },
      },
      "required": [
        "interview_id",
        "overall_score",
        "feedback",
      ],
      "type": "object",
    },
    "name": "mock_interview_finish",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.write",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Delete interview session",
    },
    "description": "Permanently delete one practice session and every answer in it. interview_id comes from mock_interview_list. There is no undo and no export first. Only call it when the user asked for that specific session to be removed; to hide a bad result from an average, tell them the score instead.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "interview_id": {
          "description": "Id from mock_interview_list.",
          "type": "string",
        },
      },
      "required": [
        "interview_id",
      ],
      "type": "object",
    },
    "name": "mock_interview_delete",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.write",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "List budget lines",
    },
    "description": "List the user's monthly budget lines — every expense and savings envelope with its amount — plus the totals for each kind. USE THIS FIRST for any money question ('how much do I spend a month', 'can I afford X') and to get the budget_id the other budget_* tools need. Amounts are monthly and in Indonesian rupiah.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "name": "budget_list",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.read",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Add budget line",
    },
    "description": "Add one monthly budget line, e.g. the user says 'tambah cicilan motor 800rb'. Read budget_list first and update the existing line instead if one already covers this — duplicates quietly double the totals the user plans against. value is a whole number of rupiah per MONTH (800rb → 800000, 1,2jt → 1200000); convert any 'per year' or 'per week' figure yourself. kind splits the two totals: money going out is 'expense', money set aside is 'savings'.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "description": "Chart colour as #rrggbb hex. Defaults to a neutral slate grey.",
          "type": "string",
        },
        "icon": {
          "description": "Icon shown next to the line. Pick the closest fit; defaults to Wallet.",
          "enum": [
            "Home",
            "Utensils",
            "Car",
            "Zap",
            "Film",
            "MoreHorizontal",
            "PiggyBank",
            "ShoppingCart",
            "Heart",
            "Book",
            "Briefcase",
            "Wallet",
            "CreditCard",
            "Gift",
            "Plane",
            "Stethoscope",
          ],
          "type": "string",
        },
        "kind": {
          "description": "'expense' for spending, 'savings' for money put aside.",
          "enum": [
            "expense",
            "savings",
          ],
          "type": "string",
        },
        "label": {
          "description": "What this line is, in the user's own words. Max 40 characters.",
          "type": "string",
        },
        "value": {
          "description": "Rupiah per month, whole number, max 1000000000.",
          "type": "number",
        },
      },
      "required": [
        "label",
        "value",
        "kind",
      ],
      "type": "object",
    },
    "name": "budget_add",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.write",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Update budget line",
    },
    "description": "Change one existing budget line — the tool for 'naikkan cicilan jadi 1jt' or 'ganti label X jadi Y'. Send only the fields that change; anything omitted is left alone. value replaces the old amount, it is not added to it. Needs a budget_id from budget_list.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "budget_id": {
          "description": "Id from budget_list.",
          "type": "string",
        },
        "color": {
          "description": "New colour as #rrggbb hex.",
          "type": "string",
        },
        "icon": {
          "description": "New icon.",
          "enum": [
            "Home",
            "Utensils",
            "Car",
            "Zap",
            "Film",
            "MoreHorizontal",
            "PiggyBank",
            "ShoppingCart",
            "Heart",
            "Book",
            "Briefcase",
            "Wallet",
            "CreditCard",
            "Gift",
            "Plane",
            "Stethoscope",
          ],
          "type": "string",
        },
        "kind": {
          "description": "Move the line between the expense and savings totals.",
          "enum": [
            "expense",
            "savings",
          ],
          "type": "string",
        },
        "label": {
          "description": "New label. Max 40 characters.",
          "type": "string",
        },
        "value": {
          "description": "New rupiah-per-month amount, replacing the old one.",
          "type": "number",
        },
      },
      "required": [
        "budget_id",
      ],
      "type": "object",
    },
    "name": "budget_update",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.write",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Delete budget line",
    },
    "description": "Permanently remove one budget line. There is no undo. When a cost has merely gone down, use budget_update instead — deleting it loses the record that the user was ever tracking it.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "budget_id": {
          "description": "Id from budget_list.",
          "type": "string",
        },
      },
      "required": [
        "budget_id",
      ],
      "type": "object",
    },
    "name": "budget_delete",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.write",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Get financial plan",
    },
    "description": "Read the user's relocation / salary plan: target salary and location, monthly expense breakdown, one-off relocation costs, the timeline in months, and the readiness score the app computed from all of it (0-100, where 100 means the money can be saved inside the timeline). Use it for 'am I financially ready to move' or 'what is my target salary'. Returns null when the user has not filled the calculator in — say so rather than guessing, and point them at the Kalkulator Keuangan page. There is no tool to write this; only the app's own calculator can.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "name": "financial_plan_get",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.read",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "List career goals",
    },
    "description": "List the user's career goals with their target date, status, percent progress and every milestone. USE THIS FIRST for anything about goals or progress ('what am I working towards', 'am I on track') and to get the goal_id and milestone numbers the other goals_* tools need. Returns all goals; a person keeps a handful, so there is no pagination.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "name": "goals_list",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.read",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Create career goal",
    },
    "description": "Create a career goal with a target date and the milestones that make it up. Break the goal into concrete, checkable steps — milestones are how progress is measured, and a goal with none stays at 0% forever. Write title, description and milestones in the language the user is speaking (usually Indonesian). Progress and status are derived from the milestones, so do not try to set them.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "description": "Free-text grouping the user's own dashboard shows, e.g. 'Karir', 'Skill', 'Finansial'. Max 50 characters.",
          "type": "string",
        },
        "description": {
          "description": "What reaching it means, and why. Max 2000 characters.",
          "type": "string",
        },
        "milestones": {
          "description": "Ordered checkable steps, up to 20. Each is one short line; they are referred to later by 1-based position.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "target_date": {
          "description": "Deadline as an ISO date, e.g. 2026-12-31.",
          "type": "string",
        },
        "title": {
          "description": "Short name for the goal. Max 120 characters.",
          "type": "string",
        },
      },
      "required": [
        "title",
        "description",
        "category",
        "target_date",
        "milestones",
      ],
      "type": "object",
    },
    "name": "goals_create",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.write",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Set milestone state",
    },
    "description": "Tick or untick one milestone. This is how a goal advances: the percentage and the active/completed status are recomputed from the milestones, so use it whenever the user says they finished (or has to redo) a step. milestone_number is the 1-based position shown by goals_list. Returns the goal's new progress.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "completed": {
          "description": "true to tick it, false to untick.",
          "type": "boolean",
        },
        "goal_id": {
          "description": "Id from goals_list.",
          "type": "string",
        },
        "milestone_number": {
          "description": "1-based position of the milestone within the goal.",
          "type": "number",
        },
      },
      "required": [
        "goal_id",
        "milestone_number",
        "completed",
      ],
      "type": "object",
    },
    "name": "goals_set_milestone",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.write",
        ],
        "type": "oauth2",
      },
    ],
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Delete career goal",
    },
    "description": "Permanently delete one goal and all of its milestones. goal_id comes from goals_list. There is no undo. A goal the user has given up on is usually better left in place — the record of what was attempted is the point — so only call this when they ask for that specific goal to be removed.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "goal_id": {
          "description": "Id from goals_list.",
          "type": "string",
        },
      },
      "required": [
