          "type": "string",
        },
        "note": {
          "description": "Free-text note about the file. Max 500 characters; empty string clears it.",
          "type": "string",
        },
        "tags": {
          "description": "COMPLETE replacement list of tags.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "file_id",
      ],
      "type": "object",
    },
    "name": "files_set_metadata",
    "securitySchemes": [
      {
        "scopes": [
          "mcp.write",
        ],
