  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Update file metadata",
    },
    "description": "Rename a library file or change its tags and note — the tool for tidying up ('tag this one as portfolio', 'rename it to CV 2026'). Send only what changes. tags REPLACE the existing list rather than being added to it, so read files_list first and send the full set; they are lowercased and de-duplicated, up to 20 of 30 characters. Send an empty string as note to clear it. This only touches labels; the file itself is untouched.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "description": "Id from files_list.",
          "type": "string",
