      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Mark all notifications read",
    },
    "description": "Mark every unread notification as read and return how many were changed. This is the tool for 'clear the badge' / 'tandai semua sudah dibaca'. Nothing is deleted. Read them out with notifications_list before calling if the user has not seen them yet, or they lose track of what was there.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
