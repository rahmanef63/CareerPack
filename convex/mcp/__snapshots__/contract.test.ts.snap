  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Save job listing",
    },
    "description": "Save a job the user found elsewhere, so it can be scanned against their CV and kept alongside the rest. YOU do the parsing: read the posting the user pasted and fill these fields in — there is no AI parser behind this tool and none is needed. Keep \`description\` as the substantive requirements text, at least 40 characters, because that is what the ATS scan scores against; a one-line summary produces a meaningless score. The listing is marked as the user's own and appears under mine=true.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "apply_url": {
          "description": "Link to apply. Must start with http:// or https://.",
          "type": "string",
        },
        "category": {
          "description": "Functional area, for the badge on the job card.",
          "enum": [
            "engineering",
            "design",
            "support",
            "product",
            "marketing",
            "data",
          ],
          "type": "string",
        },
        "company": {
          "description": "Company name. Max 200 characters.",
          "type": "string",
        },
        "currency": {
          "description": "Currency of the salary range, e.g. IDR or USD.",
          "type": "string",
        },
        "description": {
          "description": "The requirements and responsibilities, 40-8000 characters. This is what the ATS scan reads — keep the real wording.",
          "type": "string",
        },
        "employment_type": {
          "description": "Contract shape.",
          "enum": [
            "full-time",
            "part-time",
            "contract",
            "internship",
          ],
          "type": "string",
        },
        "location": {
          "description": "City/country, or 'Remote'. Max 120 characters.",
          "type": "string",
        },
        "required_skills": {
          "description": "5-15 short technical terms as written in the posting ('React', 'Node.js', 'SQL'), up to 30.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "salary_max": {
          "description": "Upper bound, raw number.",
          "type": "number",
        },
        "salary_min": {
          "description": "Lower bound, raw number.",
          "type": "number",
        },
        "seniority": {
          "description": "Level, inferred from the title and required experience.",
          "enum": [
            "junior",
            "mid-level",
            "senior",
            "lead",
          ],
          "type": "string",
        },
        "title": {
          "description": "Position title. Max 200 characters.",
          "type": "string",
        },
        "work_mode": {
          "description": "Work mode.",
          "enum": [
            "remote",
            "hybrid",
            "onsite",
          ],
          "type": "string",
        },
